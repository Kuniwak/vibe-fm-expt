   "... N ! | N",
   "... N = | N",
   "... N [] | N",
   "... N | ? N",
   "... N | ! N",
   "... ? N | N",
   "... ! N | N",
   "... N ? = | N",
   "... N ? | ? N",
   "... N ? | ! N",
   "... N ! = | N",
   "... N ! | ? N",
   "... N ! | ! N",
   "... N = | ? N",
   "... N = | ! N",
   "... N [] [] | N",
   "... N [] | ? N",
   "... N [] | ! N",
   "... N . N | N",
   "... N ~ N | N",
   "... N # N | N",
   "... ? N | ? N",
   "... ? N | ! N",
   "... ! N | ? N",
   "... ! N | ! N"
  ],
  "examples": [
   "...A|B",
   "...A?|B"
  ]
 },
 {
  "id": "F3",
