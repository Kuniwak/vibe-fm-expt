   "! N . N ?",
   "! N . N !",
   "! N . N =",
   "! N ~ N ?",
   "! N ~ N !",
   "! N ~ N =",
   "! N # N ?",
   "! N # N !",
   "! N # N ="
  ],
  "examples": [
   "?A?",
   "!A=",
   "?A.B!"
  ]
 },
 {
  "id": "F2",
  "title": "prefix ... against |: the table gives (...A)|B, the parser gives ...(A|B)",
