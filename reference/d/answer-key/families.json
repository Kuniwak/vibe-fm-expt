[
 {
  "id": "F1",
  "title": "prefix ?/! combined with suffix ?/!/=: the table applies the suffix first, the parser applies the prefix first",
  "patterns": [
   "? N ?",
   "? N !",
   "? N =",
   "! N ?",
   "! N !",
   "! N =",
   "? N . N ?",
   "? N . N !",
   "? N . N =",
   "? N ~ N ?",
   "? N ~ N !",
   "? N ~ N =",
   "? N # N ?",
   "? N # N !",
