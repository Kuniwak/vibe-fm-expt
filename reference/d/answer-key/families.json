   "N = !",
   "N = =",
   "N = []",
   "N [] ?",
   "N [] !",
   "N [] =",
   "N ? = ?",
   "N ? = !",
   "N ? = =",
   "N ? = []",
   "N ! = ?",
   "N ! = !",
   "N ! = =",
   "N ! = []",
   "N [] [] ?",
   "N [] [] !",
   "N [] [] =",
   "N [] [] [] ?",
   "N [] [] [] !",
   "N [] [] [] =",
   "N [] [] [] [] ?",
   "N [] [] [] [] !",
   "N [] [] [] [] ="
  ],
  "examples": [
