import @@MODULE@@
import Lean
open Lean Elab Command in
#eval show CommandElabM Unit from do
  let env ← getEnv
  let some idx := env.getModuleIdx? `@@MODULE@@ | throwError "module @@MODULE@@ not found"
  for n in env.header.moduleData[idx.toNat]!.constNames do
    if n.isInternalDetail then continue
    if (match n with | .str _ s => s.startsWith "eq_" | _ => false) then continue
    match env.find? n with
    | some (.thmInfo _) =>
      let axs ← Lean.collectAxioms n
      logInfo m!"AXIOMS theorem {n}: {axs.toList}"
    | some (.axiomInfo _) =>
      logInfo m!"AXIOMS declared-axiom {n}"
    | _ => pure ()
